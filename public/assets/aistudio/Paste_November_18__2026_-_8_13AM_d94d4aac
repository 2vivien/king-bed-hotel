      const adultEl = document.getElementById('adult-count');
      const incBtn = document.querySelector('[aria-label="Increase Adults"]');
      const decBtn = document.querySelector('[aria-label="Decrease Adults"]');

      if (incBtn && decBtn && adultEl) {
        incBtn.addEventListener('click', () => {
          adultCount++;
          adultEl.textContent = adultCount;
        });
        decBtn.addEventListener('click', () => {
          if (adultCount > 1) {
            adultCount--;
            adultEl.textContent = adultCount;
          }
        });
      }

      // Smooth interaction for destination select
      const select = document.getElementById('destination-select');
